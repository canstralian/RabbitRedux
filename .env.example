# RabbitRedux Environment Configuration
# Copy this file to .env and update with your values

# Application Environment
ENVIRONMENT=development  # development, staging, or production

# Flask Configuration
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rabbitredux

# Connection Pool Settings (optional - uses defaults if not set)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# PGBouncer Configuration (set to true if using PGBouncer)
USE_PGBOUNCER=false

# Backup Configuration
BACKUP_DIR=/var/backups/rabbitredux
RETAIN_DAYS=7
RETAIN_MONTHS=3
S3_BUCKET=  # Optional: S3 bucket for remote backups
NOTIFICATION_EMAIL=  # Optional: Email for backup notifications
