# RabbitRedux Environment Configuration
# Copy this file to .env and configure for your environment
# TODO: Add environment-specific .env templates (.env.development, .env.production)
# TODO: Implement secrets validation on startup
# TODO: Add documentation links for each configuration section

# Application Settings
APP_NAME="RabbitRedux"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=4
RELOAD=True  # Auto-reload on code changes (development only)

# Security
# TODO: Add password hashing support for user authentication
# TODO: Implement certificate-based authentication
# TODO: Add IP whitelisting configuration
SECRET_KEY="change-me-in-production-use-openssl-rand-hex-32"
API_KEY="your-api-key-here"  # For API authentication
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"  # CORS

# Model Configuration
# TODO: Add model ensemble configuration
# TODO: Support A/B testing with multiple model versions
# TODO: Add model update notification mechanism
DEFAULT_MODEL="canstralian/WhiteRabbitNeo"
MODEL_CACHE_DIR="./model_cache"
MAX_MODEL_LENGTH=512
ENABLE_GPU=True  # Use GPU if available

# HuggingFace Configuration
HF_TOKEN=""  # Optional: for private models or higher rate limits
HF_HOME="./huggingface_cache"

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or text

# Redis (Optional - for distributed caching)
REDIS_ENABLED=False
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# Database (Optional - for future features)
DATABASE_URL="sqlite:///./rabbitredux.db"

# Performance
MAX_BATCH_SIZE=32
REQUEST_TIMEOUT=300  # seconds
WORKER_TIMEOUT=600  # seconds

# Feature Flags
# TODO: Add gradual feature rollout percentages
# TODO: Implement user-specific feature toggles
# TODO: Add feature flag analytics and usage tracking
ENABLE_BATCH_CLASSIFICATION=True
ENABLE_MODEL_VERSIONING=True
ENABLE_AUTHENTICATION=False  # Set to True in production
REQUIRE_API_KEY=False  # Set to True in production
